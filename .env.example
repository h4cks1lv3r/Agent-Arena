# Copy this file to .env on YOUR computer. Do not share actual keys.
# ONLY Alpaca PAPER account credentials. One separate account per agent.
ALPACA_OPENAI_KEY=
ALPACA_OPENAI_SECRET=
ALPACA_CLAUDE_KEY=
ALPACA_CLAUDE_SECRET=
# Market-data feed: iex (default) or sip (requires account entitlement).
# ALPACA_DATA_FEED=iex
# Optional paid model providers. Budget remains $0 until you change settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional remote dashboard access. Prefer server.py --init-access.
# This is NOT a broker or model API key.
# ARENA_ACCESS_TOKEN=
